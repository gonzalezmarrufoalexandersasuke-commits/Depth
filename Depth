local conexionTemblor = RunService.RenderStepped:Connect(function()
    if not entidad or not entidad.Parent then return end
    local personaje = localPlayer.Character
    if personaje and personaje:FindFirstChild("HumanoidRootPart") then
        local distancia = (entidad.Position - personaje.HumanoidRootPart.Position).Magnitude
        if distancia < 150 then
            local fuerzaEfectiva = math.clamp((150 - distancia) / 35, 0.2, 1.5)
            
            local offsetAleatorio = Vector3.new(
                math.random(-50, 50) * 0.007 * fuerzaEfectiva,
                math.random(-50, 50) * 0.007 * fuerzaEfectiva,
                math.random(-50, 50) * 0.007 * fuerzaEfectiva
            )
            local anguloAleatorio = CFrame.Angles(
                math.rad(math.random(-25, 25) * 0.015 * fuerzaEfectiva),
                math.rad(math.random(-25, 25) * 0.015 * fuerzaEfectiva),
                math.rad(math.random(-25, 25) * 0.015 * fuerzaEfectiva)
            )
            
            Camara.CFrame = Camara:GetRenderCFrame() * CFrame.new(offsetAleatorio) * anguloAleatorio
        end
    end
end)

task.spawn(function()
